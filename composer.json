{
  "name": "amp-framework/ampf",
  "description": "ampf MVC PHP framework",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "ampf\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ampf\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.5",
    "ext-ctype": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-session": "*",
    "doctrine/orm": "^3.7",
    "symfony/cache": "^8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.35.4",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^13.3",
    "slevomat/coding-standard": "^8.31",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "scripts": {
    "phpcs": "@php vendor/bin/phpcs src config tests",
    "phpcbf": "@php vendor/bin/phpcbf src config tests",
    "cs:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "cs:fix": "@php vendor/bin/php-cs-fixer fix",
    "phpstan": "@php -dmemory_limit=1G vendor/bin/phpstan analyse",
    "test": "@php vendor/bin/phpunit"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "infection/extension-installer": true
    }
  }
}
